<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Student.master.cs" Inherits="OnlineCourse.Student" %>

<!DOCTYPE html>

<html>
<head runat="server">

    <title>LearnSphere - Student</title>

    <link href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700,800,900" rel="stylesheet">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

    <link rel="stylesheet" href="css/animate.css">
    <link rel="stylesheet" href="css/owl.carousel.min.css">
    <link rel="stylesheet" href="css/owl.theme.default.min.css">
    <link rel="stylesheet" href="css/magnific-popup.css">
    <link rel="stylesheet" href="css/bootstrap-datepicker.css">
    <link rel="stylesheet" href="css/jquery.timepicker.css">
    <link rel="stylesheet" href="css/flaticon.css">
    <link rel="stylesheet" href="css/style.css">

    <style>

        /* ================================
           LEARNSPHERE STUDENT MASTER
           ================================ */

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            font-family: 'Poppins', sans-serif;
            background: #070b1d;
        }

        body {
            overflow-x: hidden;
        }

        /* ================================
           STUDENT NAVBAR
           ================================ */

        .student-navbar {
            width: 100%;
            min-height: 82px;
            position: relative;
            z-index: 9999;

            background:
                linear-gradient(
                    135deg,
                    rgba(18, 12, 48, 0.97),
                    rgba(10, 22, 52, 0.97)
                );

            border-bottom: 1px solid rgba(120, 120, 255, 0.22);

            box-shadow:
                0 10px 40px rgba(0, 0, 0, 0.35),
                0 0 30px rgba(124, 58, 237, 0.10);

            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .student-nav-container {
            width: 94%;
            max-width: 1500px;
            min-height: 82px;
            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
        }

        /* ================================
           LOGO
           ================================ */

        .student-logo {
            text-decoration: none !important;
            font-size: 30px;
            font-weight: 800;
            letter-spacing: -1px;
            white-space: nowrap;

            color: #ffffff !important;

            text-shadow:
                0 0 18px rgba(124, 58, 237, 0.45);
        }

        .student-logo span {
            background: linear-gradient(
                90deg,
                #a78bfa,
                #22d3ee
            );

            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .student-logo:hover {
            text-decoration: none;
        }

        /* ================================
           NAVIGATION
           ================================ */

        .student-nav-menu {
            display: flex;
            align-items: center;
            justify-content: flex-end;

            gap: 5px;

            margin: 0;
            padding: 0;

            list-style: none;
        }

        .student-nav-menu li {
            margin: 0;
            padding: 0;
        }

        .student-nav-menu li a {
            position: relative;

            display: block;

            padding: 11px 12px;

            color: #cbd5e1 !important;

            text-decoration: none !important;

            font-size: 13px;
            font-weight: 600;

            border-radius: 12px;

            transition:
                color 0.3s ease,
                background 0.3s ease,
                box-shadow 0.3s ease,
                transform 0.3s ease;
        }

        .student-nav-menu li a:hover {
            color: #ffffff !important;

            background:
                linear-gradient(
                    135deg,
                    rgba(124, 58, 237, 0.24),
                    rgba(6, 182, 212, 0.15)
                );

            box-shadow:
                0 0 18px rgba(124, 58, 237, 0.18);

            transform: translateY(-2px);
        }

        .student-nav-menu li a:after {
            content: "";

            position: absolute;

            left: 50%;
            bottom: 4px;

            width: 0;
            height: 2px;

            border-radius: 10px;

            background:
                linear-gradient(
                    90deg,
                    #8b5cf6,
                    #06b6d4
                );

            transform: translateX(-50%);

            transition: width 0.3s ease;
        }

        .student-nav-menu li a:hover:after {
            width: 55%;
        }

        /* ================================
           CONTENT AREA
           ================================ */

        .student-main-content {
            position: relative;

            min-height: calc(100vh - 82px);

            background:
                radial-gradient(
                    circle at 10% 15%,
                    rgba(124, 58, 237, 0.16),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 90% 25%,
                    rgba(6, 182, 212, 0.12),
                    transparent 28%
                ),
                radial-gradient(
                    circle at 50% 100%,
                    rgba(168, 85, 247, 0.08),
                    transparent 35%
                ),
                linear-gradient(
                    135deg,
                    #070b1d 0%,
                    #0c1028 50%,
                    #081225 100%
                );

            overflow: hidden;
        }

        /* Decorative glow */

        .student-main-content:before {
            content: "";

            position: absolute;

            width: 280px;
            height: 280px;

            top: 120px;
            left: -120px;

            border-radius: 50%;

            background: rgba(124, 58, 237, 0.10);

            filter: blur(70px);

            pointer-events: none;
        }

        .student-main-content:after {
            content: "";

            position: absolute;

            width: 300px;
            height: 300px;

            right: -130px;
            bottom: 100px;

            border-radius: 50%;

            background: rgba(6, 182, 212, 0.08);

            filter: blur(75px);

            pointer-events: none;
        }

        .student-content-inner {
            position: relative;
            z-index: 2;
        }

        /* ================================
           MOBILE MENU BUTTON
           ================================ */

        .student-menu-button {
            display: none;

            width: 45px;
            height: 45px;

            border: 1px solid rgba(255, 255, 255, 0.15);

            border-radius: 12px;

            background:
                rgba(255, 255, 255, 0.06);

            color: #ffffff;

            font-size: 20px;

            cursor: pointer;

            align-items: center;
            justify-content: center;
        }

        .student-menu-button:hover {
            background:
                rgba(124, 58, 237, 0.25);
        }

        /* ================================
           RESPONSIVE
           ================================ */

        @media (max-width: 1250px) {

            .student-nav-menu {
                gap: 1px;
            }

            .student-nav-menu li a {
                padding: 10px 8px;
                font-size: 12px;
            }

            .student-logo {
                font-size: 27px;
            }
        }

        @media (max-width: 1050px) {

            .student-nav-container {
                width: 92%;
            }

            .student-menu-button {
                display: flex;
            }

            .student-nav-menu {
                display: none;

                position: absolute;

                top: 82px;
                left: 4%;
                right: 4%;

                flex-direction: column;
                align-items: stretch;

                padding: 12px;

                border: 1px solid rgba(255, 255, 255, 0.10);

                border-radius: 18px;

                background:
                    linear-gradient(
                        135deg,
                        rgba(18, 12, 48, 0.98),
                        rgba(10, 22, 52, 0.98)
                    );

                box-shadow:
                    0 20px 50px rgba(0, 0, 0, 0.45),
                    0 0 30px rgba(124, 58, 237, 0.12);

                backdrop-filter: blur(20px);
            }

            .student-nav-menu.show {
                display: flex;
            }

            .student-nav-menu li {
                width: 100%;
            }

            .student-nav-menu li a {
                width: 100%;
                box-sizing: border-box;

                padding: 13px 16px;

                border-radius: 12px;
            }

            .student-nav-menu li a:after {
                display: none;
            }
        }

        @media (max-width: 600px) {

            .student-navbar {
                min-height: 72px;
            }

            .student-nav-container {
                min-height: 72px;
            }

            .student-logo {
                font-size: 24px;
            }

            .student-nav-menu {
                top: 72px;
                left: 3%;
                right: 3%;
            }

            .student-main-content {
                min-height: calc(100vh - 72px);
            }
        }

    </style>

    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>

<body>

<form id="form1" runat="server">

    <!-- STUDENT NAVBAR -->

    <nav class="student-navbar">

        <div class="student-nav-container">

            <!-- LOGO -->

            <a class="student-logo" href="index.aspx">
                <span>Learn</span>Sphere
            </a>


            <!-- MOBILE BUTTON -->

            <button
                type="button"
                class="student-menu-button"
                onclick="toggleStudentMenu()">

                <i class="fa fa-bars"></i>

            </button>


            <!-- NAVIGATION -->

            <ul class="student-nav-menu" id="studentNavMenu">

                <li>
                    <a href="StudentDashboard.aspx">
                        Dashboard
                    </a>
                </li>

                <li>
                    <a href="index2.aspx">
                        Home
                    </a>
                </li>

                <li>
                    <a href="course.aspx">
                        Courses
                    </a>
                </li>

                <li>
                    <a href="MyCourses.aspx">
                        My Courses
                    </a>
                </li>

                <li>
                    <a href="Profile.aspx">
                        Profile
                    </a>
                </li>

                <li>
                    <a href="videolesson.aspx">
                        Video Lesson
                    </a>
                </li>

                <li>
                    <a href="enrollcourse.aspx">
                        Enroll Course
                    </a>
                </li>

                <li>
                    <a href="feedback.aspx">
                        Feedback
                    </a>
                </li>

                <li>
                    <a href="exam.aspx">
                        Exam
                    </a>
                </li>

                <li>
                    <a href="Certificate.aspx">
                        Certificate
                    </a>
                </li>

                <li>
                    <a href="logout.aspx">
                        Logout
                    </a>
                </li>

            </ul>

        </div>

    </nav>


    <!-- PAGE CONTENT -->

    <main class="student-main-content">

        <div class="student-content-inner">

            <asp:ContentPlaceHolder
                ID="ContentPlaceHolder1"
                runat="server">
            </asp:ContentPlaceHolder>

        </div>

    </main>

</form>


<!-- SCRIPTS -->

<script src="js/jquery.min.js"></script>
<script src="js/jquery-migrate-3.0.1.min.js"></script>
<script src="js/popper.min.js"></script>
<script src="js/bootstrap.min.js"></script>
<script src="js/jquery.easing.1.3.js"></script>
<script src="js/jquery.waypoints.min.js"></script>
<script src="js/jquery.stellar.min.js"></script>
<script src="js/owl.carousel.min.js"></script>
<script src="js/jquery.magnific-popup.min.js"></script>
<script src="js/jquery.animateNumber.min.js"></script>
<script src="js/bootstrap-datepicker.js"></script>
<script src="js/scrollax.min.js"></script>
<script src="js/google-map.js"></script>
<script src="js/main.js"></script>


<script>

    function toggleStudentMenu() {

        var menu = document.getElementById("studentNavMenu");

        if (menu.classList.contains("show")) {

            menu.classList.remove("show");

        }
        else {

            menu.classList.add("show");

        }

    }

</script>

</body>
</html>